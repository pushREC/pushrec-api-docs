#!/usr/bin/env bash
#
# api-docs - Claude ecosystem documentation management CLI
# Version: 1.0.0
#
# Usage:
#   api-docs update [--source=<source>]  Scrape documentation
#   api-docs status                       Show coverage and staleness
#   api-docs deprecate <file>             Mark a doc as deprecated
#   api-docs archive                      Move >30-day deprecated files
#   api-docs diff <source>                Show changes since last scrape
#   api-docs validate                     Run quality checks
#   api-docs index                        Rebuild cross-reference index
#   api-docs help                         Show this help message

set -euo pipefail

# Resolve script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(dirname "$SCRIPT_DIR")"
LIB_DIR="$SCRIPT_DIR/lib"
CONFIG_FILE="$SCRIPT_DIR/config/sources.yaml"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Logging functions
log_info() { echo -e "${BLUE}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[OK]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }

# Show help
show_help() {
    cat << 'EOF'
api-docs - Claude ecosystem documentation management

USAGE:
    api-docs <command> [options]

COMMANDS:
    update [--source=<source>]   Scrape all or specific source
    status                        Show coverage, staleness, deprecated
    deprecate <file>              Mark a doc as deprecated
    archive                       Move >30-day deprecated to _deprecated/
    diff <source>                 Show changes since last scrape
    validate                      Run all quality checks
    index                         Rebuild cross-reference index
    help                          Show this help message

SOURCES:
    claude-code    Claude Code documentation
    claude-api     Claude API documentation
    agent-sdk      Claude Agent SDK

EXAMPLES:
    api-docs update                       # Update all sources
    api-docs update --source=claude-code  # Update only Claude Code docs
    api-docs status                       # Show current status
    api-docs deprecate claude-code/build/old-feature.md
    api-docs archive                      # Archive old deprecated files

EOF
}

# Verify Python and dependencies
check_python() {
    if ! command -v python3 &> /dev/null; then
        log_error "Python 3 is required but not installed"
        exit 1
    fi
}

# Run Python module
run_python() {
    local module="$1"
    shift
    python3 "$LIB_DIR/$module" "$@"
}

# Update command
cmd_update() {
    local source=""

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            --source=*)
                source="${1#*=}"
                shift
                ;;
            *)
                log_error "Unknown option: $1"
                exit 1
                ;;
        esac
    done

    log_info "Starting documentation update..."

    if [[ -n "$source" ]]; then
        log_info "Source: $source"
        run_python scraper.py --source="$source" --config="$CONFIG_FILE" --output="$REPO_DIR"
    else
        log_info "Updating all sources..."
        run_python scraper.py --all --config="$CONFIG_FILE" --output="$REPO_DIR"
    fi

    # Run hash comparison for change detection
    log_info "Detecting changes..."
    run_python hasher.py --repo="$REPO_DIR"

    log_success "Update complete"
}

# Status command
cmd_status() {
    log_info "Documentation Status"
    echo ""
    run_python validation.py --status --repo="$REPO_DIR"
}

# Deprecate command
cmd_deprecate() {
    if [[ $# -lt 1 ]]; then
        log_error "Usage: api-docs deprecate <file>"
        exit 1
    fi

    local file="$1"
    local full_path="$REPO_DIR/$file"

    if [[ ! -f "$full_path" ]]; then
        log_error "File not found: $file"
        exit 1
    fi

    log_info "Marking as deprecated: $file"
    run_python deprecation.py --mark "$full_path" --repo="$REPO_DIR"
    log_success "File marked as deprecated"
}

# Archive command
cmd_archive() {
    log_info "Archiving deprecated files older than 30 days..."
    run_python deprecation.py --archive --repo="$REPO_DIR"
    log_success "Archive complete"
}

# Diff command
cmd_diff() {
    if [[ $# -lt 1 ]]; then
        log_error "Usage: api-docs diff <source>"
        exit 1
    fi

    local source="$1"
    log_info "Changes for: $source"
    run_python hasher.py --diff --source="$source" --repo="$REPO_DIR"
}

# Validate command
cmd_validate() {
    log_info "Running quality validation..."
    run_python validation.py --full --repo="$REPO_DIR"
}

# Index command
cmd_index() {
    log_info "Rebuilding cross-reference index..."
    run_python index_builder.py --repo="$REPO_DIR" --config="$CONFIG_FILE"
    log_success "Index rebuilt"
}

# Main entry point
main() {
    check_python

    if [[ $# -lt 1 ]]; then
        show_help
        exit 0
    fi

    local command="$1"
    shift

    case "$command" in
        update)
            cmd_update "$@"
            ;;
        status)
            cmd_status "$@"
            ;;
        deprecate)
            cmd_deprecate "$@"
            ;;
        archive)
            cmd_archive "$@"
            ;;
        diff)
            cmd_diff "$@"
            ;;
        validate)
            cmd_validate "$@"
            ;;
        index)
            cmd_index "$@"
            ;;
        help|--help|-h)
            show_help
            ;;
        *)
            log_error "Unknown command: $command"
            show_help
            exit 1
            ;;
    esac
}

main "$@"
